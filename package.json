{
  "name": "jbod",
  "version": "0.5.1",
  "description": "JavaScript Binary Serialization and deserialization. Support for more JS data types",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "types": "./dist/mod.d.ts",
  "scripts": {
    "ci:test": "vitest run",
    "ci:build": "rolldown -c && tsc -p src/tsconfig.json --noEmit false --emitDeclarationOnly --outDir dist",
    "build": "pnpm run ci:build && pnpm run api:check -l",
    "test": "vitest",
    "type:check": "tsc",
    "check:src": "tsc -p src/tsconfig.json",
    "api:check": "api-extractor run -c api-extractor.jsonc -v"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "rolldown": "^1.2.9",
    "typescript": "^7.0.2",
    "vitest": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asnowc/jbod"
  },
  "exports": {
    ".": "./dist/mod.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "keywords": [
    "json",
    "serialize",
    "protobuf",
    "bson"
  ],
  "author": {
    "name": "Eavid",
    "url": "https://github.com/eavidy"
  },
  "license": "MIT"
}
